{
  "name": "ACU CSE 101 - Introduction to Programming",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  
  "customizations": {
    "vscode": {
      "settings": {
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000,
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "exercises"
        ],
        "python.testing.unittestEnabled": false,
        "python.testing.autoTestDiscoverOnSaveEnabled": true,
        "tasks.statusBar": [
          {
            "label": "$(pass) Check My Code",
            "task": "🧪 Run Tests for Current Week",
            "tooltip": "Run automated unit tests to verify your code"
          },
          {
            "label": "$(cloud-upload) Submit Practice",
            "task": "🚀 Submit Current Week Practice",
            "tooltip": "Submit your practice code to the TA review system"
          },
          {
            "label": "$(sync) Sync Course",
            "task": "🔄 Sync Course Materials with Upstream",
            "tooltip": "Pull new weekly challenges from the course"
          }
        ]
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "eamodio.gitlens",
        "actboy168.tasks"
      ]
    }
  },

  "postCreateCommand": "bash .devcontainer/post_create.sh",
  "postStartCommand": "python3 scripts/auto_commit_daemon.py &"
}
