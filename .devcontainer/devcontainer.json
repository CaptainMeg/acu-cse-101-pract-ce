{
  "name": "ACU CSE 101 - Introduction to Programming",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  
  "customizations": {
    "vscode": {
      "settings": {
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000,
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.exclude": {
          "**/.git": true,
          "**/.svn": true,
          "**/.hg": true,
          "**/CVS": true,
          "**/.DS_Store": true,
          "**/Thumbs.db": true,
          "scripts": true,
          ".devcontainer": true,
          ".pytest_cache": true,
          "pytest.ini": true,
          "requirements.txt": true,
          "requirements-dev.txt": true
        },
        "git.enabled": false,
        "git.decorations.enabled": false,
        "scm.diffDecorations": "none",
        "github.copilot.enable": {
          "*": false
        },
        "github.copilot.editor.enableCodeActions": false,
        "chat.commandCenter.enabled": false,
        "inlineChat.enable": false,
        "extensions.ignoreRecommendations": true,
        "extensions.autoCheckUpdates": false,
        "extensions.autoUpdate": false,
        "workbench.startupEditor": "none",
        "workbench.tips.enabled": false,
        "workbench.welcomePage.walkthroughs.openOnInstall": false,
        "telemetry.telemetryLevel": "off",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "exercises"
        ],
        "python.testing.unittestEnabled": false,
        "python.testing.autoTestDiscoverOnSaveEnabled": true,
        "tasks.statusBar": [
          {
            "label": "$(pass) Run Tests",
            "task": "Run Tests",
            "tooltip": "Run automated unit tests to verify your code"
          },
          {
            "label": "$(cloud-upload) Submit",
            "task": "Submit",
            "tooltip": "Submit your practice code to the TA review system"
          },
          {
            "label": "$(sync) Sync Course",
            "task": "Sync Course",
            "tooltip": "Pull new weekly challenges from the course"
          },
          {
            "label": "$(play) Play",
            "task": "Play",
            "tooltip": "Run current Python file"
          }
        ]
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "actboy168.tasks"
      ]
    }
  },

  "postCreateCommand": "bash .devcontainer/post_create.sh",
  "postStartCommand": "python3 scripts/auto_commit_daemon.py > /dev/null 2>&1 &"
}
